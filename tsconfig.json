{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "paths": {
      "#cds-models/*": ["./@cds-models/*"]
    }
  },
  "exclude": [
    "eslint.config.mjs"
  ]
}
